{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "Boolean Node Save File",
	"description": "A json save file containing multiple node graphs",

	"type": "object",
	"properties": {
		"graphs": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"name": { "type": "string" },
					"nodes": {
						"type": "array",
						"items": {
							"type": "object",
							"properties": {
								"guid": { "$ref": "#/$defs/guid"},
								"name": { "type": "string" },
								"type": { "type": "string" },
								"position": {
									"type": "object",
									"properties": {
										"x": { "type": "number" },
										"y": { "type": "number" }
									},
									"required": [ "x", "y" ],
									"additionalProperties": false
								},
								"outputSockets": { "$ref": "#/$defs/socketArray" },
								"inputSockets": { "$ref": "#/$defs/socketArray" }
							},
							"required": [ "guid", "name", "type", "position" ],
							"additionalProperties": false
						}
					},
					"connections": {
						"type": "array",
						"items": {
							"type": "object",
							"properties": {
								"input": { "$ref": "#/$defs/guid"},
								"output": { "$ref": "#/$defs/guid"}
							},
							"required": [ "input", "output" ],
							"additionalProperties": false
						}
					}
				},
				"required": [ "name", "nodes", "connections" ],
				"additionalProperties": false
			}
		},
		"projectName": { "type": "string" }
	},
	"required": [ "graphs", "projectName" ],

	"$defs": {
		"guid": {
			"type": "string",
			"format": "uuid",
			"pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
		},
		"socketArray": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"guid": { "$ref": "#/$defs/guid"},
					"name": { "type": "string" },
					"type": { "type": "string" }
				},
				"required": [ "guid", "name", "type" ],
				"additionalProperties": false
			}
		}
	}
}